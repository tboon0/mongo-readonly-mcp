{
  "name": "mongo-readonly-mcp",
  "version": "0.1.0",
  "description": "Read-only MongoDB MCP server and CLI with named connections to multiple hosts, ports, and databases.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tboon0/mongo-readonly-mcp.git"
  },
  "homepage": "https://github.com/tboon0/mongo-readonly-mcp#readme",
  "bugs": {
    "url": "https://github.com/tboon0/mongo-readonly-mcp/issues"
  },
  "bin": {
    "mongo-readonly-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "profiles.yaml.example",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test:package": "node scripts/validate-package.mjs",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "serve": "node dist/index.js serve",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mongodb",
    "cli",
    "read-only",
    "multi-connection",
    "troubleshooting"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^12.0.0",
    "mongodb": "^6.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "mongodb-memory-server": "^10.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  }
}
